{% extends 'basesecond.html.twig' %}

{% block title %}Nouvelle Offre{% endblock %}

{% block body %}

    <div class="container">
        <h1>Ajouter une entreprise</h1>
            {% for type, messages in app.flashes %}
                <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                    {% for message in messages %}
                        {{ message|raw }}
                    {% endfor %}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
            <form action="{{ path('entreprise_new') }}" method="post" enctype="multipart/form-data">
                <!-- Champs du formulaire -->
                <div class="form-group">
                    <label for="libele" class="form-label">Libellé</label>
                    <input type="text" id="libele" name="libele" class="form-control" required>
                </div>
                <div class="form-group">
                    <label for="secteur" class="form-label">Secteur d'activité</label>
                    <input type="text" id="secteur" name="secteur" class="form-control" required>
                </div>
                <div class="form-group">
                    <label for="description" class="form-label">description</label>
                    <textarea id="description" name="description" class="form-control" rows="5" required></textarea>
                </div>
                <div class="form-group">
                    <label for="situation_geographique" class="form-label">Situation géographique</label>
                    <input type="text" id="situation_geographique" name="situation_geographique" class="form-control" required>
                </div>
                <div class="form-group">
                    <label for="logo" class="form-label"><i class="bi bi-image"></i> Logo de l'entreprise :</label>
                    <input type="file" class="form-control" id="logo" name="logo" accept="image/png">
                    <small class="form-text text-muted">Seuls les fichiers PNG de moins de 5Mo sont autorisés.</small>
                </div>                
                <button type="submit" class="btn btn-primary">Enregistrer</button>
            </form>
    </div>

{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/form-validation.js') }}"></script>
    <!-- Core Scripts -->
    <script src="{{ asset('js/core/jquery-3.7.1.min.js') }}" defer></script>
    <script src="{{ asset('js/core/popper.min.js') }}" defer></script>
    <script src="{{ asset('js/core/bootstrap.min.js') }}" defer></script>

    <!-- Plugins -->
    <script src="{{ asset('js/plugin/jquery-scrollbar/jquery.scrollbar.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/chart.js/chart.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/jquery.sparkline/jquery.sparkline.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/chart-circle/circles.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/datatables/datatables.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/bootstrap-notify/bootstrap-notify.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/jsvectormap/jsvectormap.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/jsvectormap/world.js') }}" defer></script>

    <!-- Main JS -->
    <script src="{{ asset('js/kaiadmin.min.js') }}" defer></script>

    <!-- Demo Scripts (à supprimer en production) -->
    <script src="{{ asset('js/setting-demo.js') }}" defer></script>
    <script src="{{ asset('js/demo.js') }}" defer></script>
{% endblock %}