{% extends 'basesecond.html.twig' %}

{% block title %}pub{% endblock %}

{% block body %}
<div class="container">
    <div class="container align-items-center">
        <h1 class="text-center mb-4">Liste des pub</h1>

        {# Affichage des messages flash #}
        {% for type, messages in app.flashes %}
            <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'error' ? 'danger' : 'info') }} alert-dismissible fade show text-center" role="alert">
                {% for message in messages %}
                    {{ message|raw }}
                {% endfor %}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <div class="row">
            {% for item in publicity %}
                <div class="col-md-4 mb-4 d-flex justify-content-center">
                    <div class="card shadow-sm" style="width: 100%;">
                        <div class="card-body text-start">
                            <h5 class="card-title">{{ item.libele }}</h5>
                            <p><strong>Image Publicitaire :</strong><a href="{{ asset('uploads/images/' ~ item.imagePub) }}"> {{ item.imagePub }}</a></p>
                            <img src="{{ asset('uploads/images/' ~ item.imagePub) }}" alt="logo" class="img-fluid" style="max-height: 50px;">
                            <p><strong>Description :</strong> {{ item.textPub|nl2br }}</p>
                            <p><strong>lien de la pub : </strong><a href="{{ item.lienOrientation }}" target="_blank" rel="noopener noreferrer">{{ item.lienOrientation }}</a></p>
                            <p><strong>Date mise en ligne :</strong> {{ item.dateMiseEnLigneAt|date('d-m-Y H:i') }}</p>
                            <p><strong>Date expiration :</strong> {{ item.dateExpirationAt|date('d-m-Y H:i') }}</p>
                            <p><strong>Entreprise :</strong> {{ item.demandeur}}</p>
                            <p><strong>Contact :</strong> {{ item.contact}}</p>

                            <p><strong>Statut de la pub :</strong>
                                {% if item.status == 1 %}
                                    <span class="badge bg-primary">Active</span>
                                    <a href="{{ path('statuspub', {'statut':0,'id': item.id}) }}" class="badge bg-warning">désactiver</a>

                                {% else %}
                                    <span class="badge bg-danger">Inactive</span>
                                    <a href="{{ path('statuspub', {'statut':1,'id': item.id}) }}" class="badge bg-primary">Réactiver</a>
                                {% endif %}
                                    <a href="{{ path('adminSupprime_pub', {'id': item.id}) }}" class="badge bg-danger" 
                                    onclick="return confirm('Voulez-vous vraiment supprimer cette publicité ?')">supprimer</a>                                
                            </p>
                        </div>
                    </div>
                </div>                                               
            {% else %}
                <p class="text-center">Aucune offre disponible.</p>
            {% endfor %}
        </div>

        <div class="row pagination-wrap">
          <div class="col-md-6 text-center text-md-left mb-4 mb-md-0">
            <span>Voir {{ (premiereEntree + 1) }}-{{ (premiereEntree + publicity|length) }} des pub {{ total }} d'emploi</span>
          </div>
          <div class="col-md-6 text-center text-md-right">
            <div class="custom-pagination ml-auto">
              {% if pageActuelle > 1 %}
                <a href="{{ path('app_publicity', {'page': pageActuelle - 1, 'pubParPage': pubParPage}) }}" class="prev">Prev</a>
              {% endif %}

              <div class="d-inline-block">
                {% for i in 1..nombreDePages %}
                  <a href="{{ path('app_publicity', {'page': i, 'pubParPage': pubParPage}) }}" 
                     class="{% if i == pageActuelle %}active{% endif %}">
                    {{ i }}
                  </a>
                {% endfor %}
              </div>

              {% if pageActuelle < nombreDePages %}
                <a href="{{ path('app_publicity', {'page': pageActuelle + 1, 'pubParPage': pubParPage}) }}" class="next">Next</a>
              {% endif %}
            </div>
          </div>
        </div>
     <a href="{{ path('publicity.new') }}" class="btn btn-primary mt-3">Ajouter une pub</a>        
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <!-- Core Scripts -->
    <script src="{{ asset('js/core/jquery-3.7.1.min.js') }}" defer></script>
    <script src="{{ asset('js/core/popper.min.js') }}" defer></script>
    <script src="{{ asset('js/core/bootstrap.min.js') }}" defer></script>

    <!-- Plugins -->
    <script src="{{ asset('js/plugin/jquery-scrollbar/jquery.scrollbar.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/chart.js/chart.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/jquery.sparkline/jquery.sparkline.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/chart-circle/circles.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/datatables/datatables.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/bootstrap-notify/bootstrap-notify.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/jsvectormap/jsvectormap.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/jsvectormap/world.js') }}" defer></script>

    <!-- Main JS -->
    <script src="{{ asset('js/kaiadmin.min.js') }}" defer></script>

    <!-- Demo Scripts (à supprimer en production) -->
    <script src="{{ asset('js/setting-demo.js') }}" defer></script>
    <script src="{{ asset('js/demo.js') }}" defer></script>
{% endblock %}