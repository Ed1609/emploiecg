{% extends 'base.html.twig' %}
{% block title %}A Propos de Nous{% endblock %}

{% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/custom-bs.css') }}">
        <link rel="stylesheet" href="{{ asset('css/jquery.fancybox.min.css') }}">
        <link rel="stylesheet" href="{{ asset('css/bootstrap-select.min.css') }}">
        <link rel="stylesheet" href="{{ asset('fonts/icomoon/style.css') }}">
        <link rel="stylesheet" href="{{ asset('fonts/line-icons/style.css') }}">
        <link rel="stylesheet" href="{{ asset('css/owl.carousel.min.css') }}">
        <link rel="stylesheet" href="{{ asset('css/animate.min.css') }}">
        <link rel="stylesheet" href="{{ asset('css/quill.snow.css') }}">        
        <link rel="stylesheet" href="{{ asset('css/style.css') }}">
{% endblock %}
{% block body %}
<div class="site-wrap">
    <!-- HOME -->
    <section class="section-hero overlay inner-page bg-image" style="background-image: url('images/hero_1.jpg');" id="home-section">
      <div class="container">
        <div class="row">
          <div class="col-md-7">
            <h1 class="text-white font-weight-bold">A propos de nous</h1>
            <div class="custom-breadcrumbs">
              <a href="{{ path('app_home') }}">Accueil</a> <span class="mx-2 slash">/</span>
              <span class="text-white"><strong>A propos de nous</strong></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="site-section pb-0">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-6 mb-5 mb-lg-0">
            <a data-fancybox data-ratio="2" href="https://vimeo.com/317571768" class="block__96788">
              <span class="play-icon"><span class="icon-play"></span></span>
              <img src="images/sq_img_6.jpg" alt="Image" class="img-fluid img-shadow">
            </a>
          </div>
          <div class="col-lg-5 ml-auto">
            <h2 class="section-title mb-3">En savoir a propos de nous</h2>
            <p class="lead">{{monSite.description}}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="site-section">
      <div class="container">
          <div class="col-md-6">
            <h3>Nous réseaux sociaux</h3>
            <p class="text-muted">Suivez-nous</p>
            <div class="social mt-4">
              <a href="{{monSite.lienFacebook}}" target="_blank" rel="noopener noreferrer"><span class="icon-facebook"></span></a>
              <a href="{{monSite.lienTwitter}}" target="_blank" rel="noopener noreferrer"><span class="icon-twitter"></span></a>
              <a href="{{monSite.lienInstagram}}" target="_blank" rel="noopener noreferrer"><span class="icon-instagram"></span></a>
              <a href="{{monSite.linkedIn}}" target="_blank" rel="noopener noreferrer"><span class="icon-linkedin"></span></a>
            </div>
          </div>
      </div>
    </section>
{% endblock %}
{% block javascripts %}
    <script src="{{'js/bootstrap-select.min.js'}}"></script>
    <script src="{{asset('js/quill.min.js')}}"></script>
    <script src="{{ asset('js/custom.js') }}"></script>
{% endblock %}
