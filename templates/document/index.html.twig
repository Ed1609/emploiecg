{% extends 'base.html.twig' %}

{% block title %}Bibliotheque{% endblock %}
{% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/custom-bs.css') }}">
        <link rel="stylesheet" href="{{ asset('css/jquery.fancybox.min.css') }}">
        <link rel="stylesheet" href="{{ asset('css/bootstrap-select.min.css') }}">
        <link rel="stylesheet" href="{{ asset('fonts/icomoon/style.css') }}">
        <link rel="stylesheet" href="{{ asset('fonts/line-icons/style.css') }}">
        <link rel="stylesheet" href="{{ asset('css/owl.carousel.min.css') }}">
        <link rel="stylesheet" href="{{ asset('css/animate.min.css') }}">
        <link rel="stylesheet" href="{{ asset('css/quill.snow.css') }}">
        <link rel="stylesheet" href="{{ asset('css/style.css') }}">        
{% endblock %}

{% block body %}
<div class="site-wrap">
    <!-- HOME -->
  <section class="section-hero home-section overlay inner-page bg-image" style="background-image: url('images/hero_1.jpg');" id="home-section">

    <div class="container">
      <div class="row align-items-center justify-content-center">
        <div class="col-md-12">
            <div class="mb-5 text-center">
              <h1 class="text-white font-weight-bold">Le moyen le plus simple pour obtenir l'emploi de vos rêves</h1>
              <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit. Cupiditate est, consequuntur perferendis.</p>
            </div>
        </div>
      </div>
    </div>
  </section>

    
    <section class="site-section">
      <div class="container">

        <div class="row mb-5 justify-content-center">
          <div class="col-md-7 text-center">
            <h2 class="section-title mb-2">{{ total }} Model(s) disponibles pour vous</h2>
          </div>
        </div>
        

        <ul class="job-listings mb-5">
          {% for docs in templateDoc %}
          <li class="job-listing d-block d-sm-flex pb-3 pb-sm-0 align-items-center">
            <a href="{{ path('document_download', {'id': docs.id}) }}"></a>
            <div class="job-listing-logo">
              <img src="{{ asset('uploads/images/pdf.svg') }}" alt="{{docs.name}}" class="img-fluid" style="max-height: 50px;">
            </div>
            <div class="job-listing-about d-sm-flex custom-width w-100 justify-content-between mx-4">
              <div class="job-listing-position custom-width w-50 mb-3 mb-sm-0">
                <h2></h2>
                  <strong>{{docs.name}}</strong>
              </div>
              <div class="job-listing-location mb-3 mb-sm-0 custom-width w-25">
                <span ></span> 
              </div>
              <div class="job-listing-meta">
                <span class="badge badge-success">Télécharger</span>
              </div>
            </div>
          </li>
          {% else %}
            <h2 class="text-center">Aucun document trouvé.</h2>
          {% endfor %} 
      </ul>
        
        <p id="no-results-message" style="display: none; color: red;">Aucun résultat trouvé.</p>

        <div class="row pagination-wrap">
          <div class="col-md-6 text-center text-md-left mb-4 mb-md-0">
            <span>Voir {{ (premiereEntree + 1) }}-{{ (premiereEntree + templateDoc|length) }} des offres {{ total }} d'emploi</span>
          </div>
          <div class="col-md-6 text-center text-md-right">
            <div class="custom-pagination ml-auto">
              {% if pageActuelle > 1 %}
                <a href="{{ path('app_home', {'page': pageActuelle - 1, 'offresParPage': DocumentsParPage}) }}" class="prev">Prev</a>
              {% endif %}

              <div class="d-inline-block">
                {% for i in 1..nombreDePages %}
                  <a href="{{ path('app_home', {'page': i, 'offresParPage': DocumentsParPage}) }}" 
                     class="{% if i == pageActuelle %}active{% endif %}">
                    {{ i }}
                  </a>
                {% endfor %}
              </div>

              {% if pageActuelle < nombreDePages %}
                <a href="{{ path('app_home', {'page': pageActuelle + 1, 'offresParPage': DocumentsParPage}) }}" class="next">Next</a>
              {% endif %}
            </div>
          </div>
        </div>

      </div>
    </section>

<section class="bg-light pt-5 testimony-full">
  <div id="carouselPublicite" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000" data-bs-pause="false">
    <div class="carousel-inner">
      {% for publicites in publicite %}
        <div class="carousel-item {% if loop.first %} active {% endif %}">
          <div class="d-flex justify-content-center align-items-center" style="height: 400px; background-image: url('{{ asset('uploads/images/' ~ publicites.imagePub) }}'); background-size: cover; background-position: center;">
            <div class="carousel-caption d-none d-md-block text-center">
              <blockquote class="blockquote">
                <p>&ldquo;{{ publicites.textPub }}&rdquo;</p>
                <footer class="blockquote-footer">{{ publicites.libele }} <cite title="Source Title">, {{ publicites.demandeur }}</cite></footer>
              </blockquote>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Contrôles du carrousel -->
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselPublicite" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselPublicite" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
  </div>
</section>
  
  </div>

{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{'js/bootstrap-select.min.js'}}"></script>
    <script src="{{asset('js/quill.min.js')}}"></script>
    <script src="{{asset('js/custom.js')}}"></script>
   
{% endblock %}
