{% extends 'basesecond.html.twig' %}

{% block body %}

<div class = "container">
    <h1 class="text-center">Ajouter un Abonné</h1>

    {% for type, messages in app.flashes %}
        <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
            {% for message in messages %}
                {{ message }}
            {% endfor %}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <form method="post" action="{{ path('AdminAbonne_New') }}" class="mt-4">
        <div class="form-group">
            <label for="msisdn" class="form-label">Numéro de téléphone (MSISDN)</label>
            <input type="text" id="msisdn" name="msisdn" class="form-control" required maxlength="15">
        </div>

        <div class="form-group">
          <label for="specialite" class="form-label">Lieu</label>
            <select class="form-control" maxlength="50" data-style="btn-white btn-lg" data-width="100%" data-live-search="true" id="Ville" name="Ville" title="Lieu de travail ?" required>
              {% for ville in villes %}
                <option value="{{ville.nomVille}}">{{ville.nomVille}}</option>
              {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="specialite" class="form-label">Spécialité</label>
            <select class="form-control" maxlength="50" data-style="btn-white btn-lg" data-width="100%" data-live-search="true" id="specialite" name="specialite" title="Choix de la spécilité?" required>
              {% for Mettier in Mettiers %}
                <option value="{{Mettier.libele}}">{{Mettier.libele}}</option>
              {% endfor %}
            </select>
        </div>
         <div class="form-group">
         <label for = "mode_debit"class="form-label">Quel mode de paiement ?</label>
            <select class="form-control" id="mode_debit" data-style="btn-white btn-lg" data-width="100%" name="mode_debit" required>
              <option value="credit">Crédit</option>
              <option value="am">Airtel Money</option>
            </select>
        </div> 

      <div hidden>
        <input name="password" id="password" class="form-control" value="K.RMASeHDyZm5tp" required>
      </div>
        <button type="submit" class="btn btn-success">Enregistrer</button>
    </form>
</div>

{% endblock %}
{% block javascripts %}
    <script src="{{ asset('js/form-validation.js') }}"></script>
    <!-- Core Scripts -->
    <script src="{{ asset('js/core/jquery-3.7.1.min.js') }}" defer></script>
    <script src="{{ asset('js/core/popper.min.js') }}" defer></script>
    <script src="{{ asset('js/core/bootstrap.min.js') }}" defer></script>

    <!-- Plugins -->
    <script src="{{ asset('js/plugin/jquery-scrollbar/jquery.scrollbar.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/chart.js/chart.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/jquery.sparkline/jquery.sparkline.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/chart-circle/circles.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/datatables/datatables.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/bootstrap-notify/bootstrap-notify.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/jsvectormap/jsvectormap.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/jsvectormap/world.js') }}" defer></script>

    <!-- Main JS -->
    <script src="{{ asset('js/kaiadmin.min.js') }}" defer></script>

    <!-- Demo Scripts (à supprimer en production) -->
    <script src="{{ asset('js/setting-demo.js') }}" defer></script>
    <script src="{{ asset('js/demo.js') }}" defer></script>

{% endblock %}
