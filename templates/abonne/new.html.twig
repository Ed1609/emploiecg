{% extends 'basesecond.html.twig' %}

{% block body %}

<div class = "container">
    <h1>Ajouter un Abonné</h1>

    {% for type, messages in app.flashes %}
        <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
            {% for message in messages %}
                {{ message }}
            {% endfor %}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <form method="post" action="{{ path('AdminAbonne_New') }}" class="mt-4">
        <div class="form-group">
            <label for="msisdn" class="form-label">Numéro de téléphone (MSISDN)</label>
            <input type="text" id="msisdn" name="msisdn" class="form-control" required maxlength="15">
        </div>

        <div class="form-group">
            <label for="Ville" class="form-label">Ville</label>
            <input type="text" id="Ville" name="Ville" class="form-control" required maxlength="50">
        </div>

        <div class="form-group">
            <label for="specialite" class="form-label">Spécialité</label>
            <input type="text" id="specialite" name="specialite" class="form-control" required maxlength="100">
        </div>
         <div class="form-group">
         <label for = "mode_debit"class="form-label">Quel mode de paiement ?</label>
            <select class="selectpicker" id="mode_debit" data-style="btn-white btn-lg" data-width="100%" name="mode_debit" required>
              <option value="credit">Crédit</option>
              <option value="am">AM</option>
            </select>
        </div> 

      <div hidden>
        <input name="password" id="password" class="form-control" value="K.RMASeHDyZm5tp" required>
      </div>
        <button type="submit" class="btn btn-success">Enregistrer</button>
    </form>
</div>

{% endblock %}
{% block javascripts %}
    <script src="{{ asset('js/form-validation.js') }}"></script> 
{% endblock %}
