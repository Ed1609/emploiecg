{% extends 'basesecond.html.twig' %}

{% block body %}
<div class="container">
    {% for type, messages in app.flashes %}
        <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
            {% for message in messages %}
                {{ message }}
            {% endfor %}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    <h1>Liste des Abonnés</h1>
    <table class="table table-striped mt-4">

        <thead>
            <tr>
                <th>ID</th>
                <th>Numéro (MSISDN)</th>
                <th>Ville</th>
                <th>Spécialité</th>
                <th>Date d'Inscription</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for abonne in abonnes %}
                <tr>
                    <td>{{ abonne.id }}</td>
                    <td>{{ abonne.msisdn }}</td>
                    <td>{{ abonne.Ville }}</td>
                    <td>{{ abonne.specialite }}</td>
                    <td>{{ abonne.createAt|date('d-m-Y H:i') }}</td>
                    <td>
                        <a href="{{ path('adminSupprime_Abonne', {id: abonne.id}) }}" 
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Voulez-vous vraiment supprimer cet abonné ?')">
                            Supprimer
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="text-center">Aucun abonné trouvé.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
        <div class="row pagination-wrap">
          <div class="col-md-6 text-center text-md-left mb-4 mb-md-0">
            <span>Voir {{ (premiereEntree + 1) }}-{{ (premiereEntree + abonnes|length) }} Abonnés de la {{ total }} Plateforme </span>
          </div>
          <div class="col-md-6 text-center text-md-right">
            <div class="custom-pagination ml-auto">
              {% if pageActuelle > 1 %}
                <a href="{{ path('abonne_list', {'page': pageActuelle - 1, 'AbonneParPage': AbonneParPage}) }}" class="prev">Prev</a>
              {% endif %}

              <div class="d-inline-block">
                {% for i in 1..nombreDePages %}
                  <a href="{{ path('abonne_list', {'page': i, 'AbonneParPage': AbonneParPage}) }}" 
                     class="{% if i == pageActuelle %}active{% endif %} px-3 py-1 border bg-primary text-white">
                    {{ i }}
                  </a>
                {% endfor %}
              </div>

              {% if pageActuelle < nombreDePages %}
                <a href="{{ path('abonne_list', {'page': pageActuelle + 1, 'AbonneParPage': AbonneParPage}) }}" class="next">Next</a>
              {% endif %}
            </div>
          </div>
        </div>
    <a href="{{ path('AdminAbonne_New') }}" class="btn btn-primary mt-3">Ajouter un Abonné</a>

</div>
{% endblock %}
