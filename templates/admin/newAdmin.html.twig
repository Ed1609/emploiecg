{% extends 'connectbase.html.twig' %}

{% block title %}Nouvel Admin{% endblock %}

{% block stylesheets %}
    {# CSS principaux #}
    <link rel="stylesheet" href="{{ asset('css/custom-bs.css') }}">
    <link rel="stylesheet" href="{{ asset('css/jquery.fancybox.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/bootstrap-select.min.css') }}">
    <link rel="stylesheet" href="{{ asset('fonts/icomoon/style.css') }}">
    <link rel="stylesheet" href="{{ asset('fonts/line-icons/style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/owl.carousel.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/animate.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
{% endblock %}

{% block body %}
<div class="site-wrap">
    <div class="container">
        <div class="card mt-5 shadow-sm">
            <div class="card-body p-4">
                <h2 class="mb-4 text-center">Inscription Administrateur</h2>
                <form id="form-inscription" action="{{ path('abonne_new') }}" method="post" class="search-jobs-form">
                    {% for type, messages in app.flashes %}
                        <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                            {% for message in messages %}
                                {{ message|raw }}
                            {% endfor %}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label for="msisdn" class="form-label">Numéro de téléphone</label>
                                <input type="text" id="msisdn" name="msisdn" class="form-control form-control-lg" required maxlength="12" placeholder="Votre numéro de téléphone">
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label for="Ville" class="form-label">Ville de travail</label>
                                <select class="selectpicker" data-style="btn-white btn-lg" data-width="100%" data-live-search="true" id="Ville" name="Ville" title="Choisissez une ville" required>
                                    {% for ville in villes %}
                                        <option value="{{ville.nomVille}}">{{ville.nomVille}}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label for="specialite" class="form-label">Spécialité</label>
                                <select class="selectpicker" data-style="btn-white btn-lg" data-width="100%" data-live-search="true" id="specialite" name="specialite" title="Choisissez une spécialité" required>
                                    {% for Mettier in Mettiers %}
                                        <option value="{{Mettier.libele}}">{{Mettier.libele}}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label for="mode_debit" class="form-label">Mode de paiement</label>
                                <select class="selectpicker" id="mode_debit" data-style="btn-white btn-lg" data-width="100%" title="Choisissez un mode de paiement" name="mode_debit" required>
                                    <option value="credit">Crédit</option>
                                    <option value="am">Airtel Money</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label for="password" class="form-label">Mot de passe</label>
                        <input type="password" id="password" name="password" class="form-control form-control-lg" placeholder="Entrez un mot de passe" required>
                    </div>

                    <div class="form-group mb-3" hidden>
                        <input type="text" name="role" id="role" class="form-control" value="ROLE_ADMIN" required>
                    </div>

                    <div class="text-center">
                        <button type="submit" class="btn btn-primary btn-lg text-white mt-4">
                            <span class="icon-login icon mr-2"></span>S'abonner
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ asset('js/form-validation.js') }}"></script>
    <script src="{{ asset('js/jquery.min.js') }}"></script>
    <script src="{{ asset('js/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ asset('js/isotope.pkgd.min.js') }}"></script>
    <script src="{{ asset('js/stickyfill.min.js') }}"></script>
    <script src="{{ asset('js/jquery.fancybox.min.js') }}"></script>
    <script src="{{ asset('js/jquery.easing.1.3.js') }}"></script>
    <script src="{{ asset('js/jquery.waypoints.min.js') }}"></script>
    <script src="{{ asset('js/jquery.animateNumber.min.js') }}"></script>
    <script src="{{ asset('js/owl.carousel.min.js') }}"></script>
    <script src="{{ asset('js/bootstrap-select.min.js') }}"></script>
    <script src="{{ asset('js/custom.js') }}"></script>
{% endblock %}