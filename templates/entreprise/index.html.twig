{% extends 'basesecond.html.twig' %}

{% block title %}Liste des entreprises{% endblock %}

{% block body %}
    <div class="container">
        <h1>Liste des entreprises</h1>
        {% for type, messages in app.flashes %}
            <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                {% for message in messages %}
                    {{ message }}
                {% endfor %}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Libellé</th>
                    <th>Secteur</th>
                    <th>Description</th>
                    <th>Situation Géographique</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for entreprise in entreprises %}
                    <tr>
                        <td>{{ entreprise.id }}</td>
                        <td>{{ entreprise.libele }}</td>
                        <td>{{ entreprise.secteur }}</td>
                        <td>{{ entreprise.Description }}</td>
                        <td>{{ entreprise.situationGeographique }}</td>
                        <td>
                        <a href="{{ path('adminSupprime_entreprise', {id: entreprise.id}) }}" 
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Voulez-vous vraiment supprimer cet abonné ?')">
                            Supprimer
                        </a>
                    </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center">Aucune entreprise trouvée.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <div class="row pagination-wrap">
          <div class="col-md-6 text-center text-md-left mb-4 mb-md-0">
            <span>Voir {{ (premiereEntree + 1) }}-{{ (premiereEntree + entreprises|length) }} Entreprise sur {{ total }} </span>
          </div>
          <div class="col-md-6 text-center text-md-right">
            <div class="custom-pagination ml-auto">
              {% if pageActuelle > 1 %}
                <a href="{{ path('entreprise_list', {'page': pageActuelle - 1, 'EntrepriseParPage': EntrepriseParPage}) }}" class="prev">Prev</a>
              {% endif %}

              <div class="d-inline-block">
                {% for i in 1..nombreDePages %}
                  <a href="{{ path('entreprise_list', {'page': i, 'EntrepriseParPage': EntrepriseParPage}) }}" 
                     class="{% if i == pageActuelle %}active{% endif %} px-3 py-1 border bg-primary text-white">
                    {{ i }}
                  </a>
                {% endfor %}
              </div>

              {% if pageActuelle < nombreDePages %}
                <a href="{{ path('entreprise_list', {'page': pageActuelle + 1, 'EntrepriseParPage': EntrepriseParPage}) }}" class="next">Next</a>
              {% endif %}
            </div>
          </div>
        </div>
        <a href="{{ path('entreprise_new') }}" class="btn btn-primary mt-3">Ajouter une entreprise</a>
    </div>
{% endblock %}
{% block javascripts %}
    <!-- Core Scripts -->
    <script src="{{ asset('js/core/jquery-3.7.1.min.js') }}" defer></script>
    <script src="{{ asset('js/core/popper.min.js') }}" defer></script>
    <script src="{{ asset('js/core/bootstrap.min.js') }}" defer></script>

    <!-- Plugins -->
    <script src="{{ asset('js/plugin/jquery-scrollbar/jquery.scrollbar.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/chart.js/chart.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/jquery.sparkline/jquery.sparkline.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/chart-circle/circles.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/datatables/datatables.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/bootstrap-notify/bootstrap-notify.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/jsvectormap/jsvectormap.min.js') }}" defer></script>
    <script src="{{ asset('js/plugin/jsvectormap/world.js') }}" defer></script>

    <!-- Main JS -->
    <script src="{{ asset('js/kaiadmin.min.js') }}" defer></script>

    <!-- Demo Scripts (à supprimer en production) -->
    <script src="{{ asset('js/setting-demo.js') }}" defer></script>
    <script src="{{ asset('js/demo.js') }}" defer></script>

{% endblock %}